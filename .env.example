# Copy this file to `.env` and fill in the values. `.env` is never committed.

# Key of the language model provider. Keep it secret.
LLM_API_KEY=
# Name of the model to use, as the provider names it.
LLM_MODEL=
# Address of the provider's OpenAI-compatible endpoint. The default is Google's Gemini endpoint.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Where the SQLite database file is kept, relative to the repository root.
DATABASE_PATH=data/cards.db

# Product analytics (docs/analytics.md). Events are sent only when ANALYTICS_ENABLED is true: keep it false on a
# developer's machine, and true in staging and production, each with its own organization and its own user.
ANALYTICS_ENABLED=false
# Address of the analytics backend (OpenObserve) as the product reaches it, such as http://127.0.0.1:5080.
ANALYTICS_URL=
# The organization of this environment in the analytics backend.
ANALYTICS_ORG=
# The stream the events go to.
ANALYTICS_STREAM=events
# The user of this environment in the analytics backend, and its password. Keep the password secret.
ANALYTICS_USER=
ANALYTICS_PASSWORD=

# Example for the VM's provider (Cloudflare Workers AI). Replace each placeholder with your own value.
# LLM_API_KEY=<token of the provider>
# LLM_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<CLOUDFLARE_ACCOUNT_ID>/ai/v1
